BootScreen {
    background: $background;
    overflow: hidden;
}

#boot {
    width: 100%;
    height: 100%;
}

StartupScreen {
    align: center middle;
    background: $background;
}

#home {
    width: 72;
    max-width: 100%;
    height: auto;
    align-horizontal: center;
}

#home-logo {
    width: 100%;
    height: auto;
    content-align: center middle;
    text-align: center;
}

#home-tag {
    width: 100%;
    height: 1;
    margin-top: 1;
    text-align: center;
}

#home-menu {
    width: 100%;
    height: auto;
    margin-top: 1;
    border: none;
    background: transparent;
}

#home-menu:focus {
    border: none;
    background: transparent;
    background-tint: transparent;
}

HomeItem {
    layout: horizontal;
    height: 1;
    padding: 0 2;
    background: transparent;
}

HomeItem .home-cursor {
    width: 3;
    color: $error;
    text-opacity: 0%;
    text-style: bold;
}

HomeItem .home-icon {
    width: 4;
    color: $error;
}

HomeItem .home-label {
    width: 1fr;
    color: $text;
}

HomeItem .home-key {
    width: auto;
    color: $text-muted;
}

#home-menu > HomeItem.-highlight {
    background: $row;
}

#home-menu > HomeItem.-highlight .home-cursor {
    text-opacity: 100%;
}

#home-menu > HomeItem.-highlight .home-label {
    text-style: bold;
}

#home-menu > HomeItem.-highlight .home-key {
    color: $error;
    text-style: bold;
}

#home-summary {
    width: 100%;
    height: 1;
    margin-top: 1;
    text-align: center;
}

#home-activity {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding: 0 2;
}

#home-tip {
    width: 100%;
    height: 1;
    margin-top: 1;
    text-align: center;
    color: $text-muted;
}

#home-footer {
    width: 100%;
    height: 1;
    margin-top: 1;
    text-align: center;
    color: $text-muted;
}

.home-text, .home-art, .home-hosts, .home-alerts, .home-stats {
    width: 100%;
    height: auto;
}

.home-label-center {
    text-align: center;
}

.home-spacer {
    width: 100%;
    height: 1;
}
