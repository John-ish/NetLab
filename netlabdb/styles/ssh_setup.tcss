SshSetupScreen {
    align: center middle;
    background: $shade;
}

#ssh-panel {
    width: 84;
    max-width: 95%;
    height: auto;
    max-height: 100%;
    overflow-y: auto;
    padding: 0 2 1 2;
    border: round $error;
    background: $background;
    border-title-color: $error;
    border-title-style: bold;
    border-title-background: $background;
    border-title-align: center;
    border-subtitle-align: center;
    border-subtitle-background: $background;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-color: $error-darken-1;
    scrollbar-color-hover: $error;
    scrollbar-color-active: $error;
}

#ssh-intro {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

#ssh-steps {
    height: auto;
    margin-top: 1;
}

#ssh-pass-label {
    display: none;
}

#ssh-pass-row {
    display: none;
}

#ssh-note {
    height: auto;
    margin-top: 1;
    color: $text;
}

#ssh-buttons {
    height: 1;
    margin-top: 1;
    align-horizontal: center;
}

#ssh-buttons Button {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 2;
    margin: 0 1;
    background: $tint;
    color: $text;
    text-style: none;
}

#ssh-buttons Button:hover {
    background: $tint-hover;
}

#ssh-buttons Button:focus {
    background: $error;
    color: $on-accent;
    text-style: bold;
}

#ssh-buttons Button:disabled {
    background: $tint-faint;
    color: $text-muted;
    text-style: none;
}

#ssh-buttons #btn-ssh-main { width: 22; }

#ssh-buttons #btn-ssh-alt { width: 18; }

#ssh-buttons #btn-ssh-cancel { width: 12; }
