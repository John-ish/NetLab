DeleteHostScreen, DeleteServiceScreen {
    align: center middle;
    background: $shade;
}

#delete-panel {
    width: 56;
    max-width: 90%;
    height: auto;
    max-height: 100%;
    overflow-y: auto;
    padding: 0 2 1 2;
    border: round $error;
    background: $background;
    border-title-color: $error;
    border-title-style: bold;
    border-title-background: $background;
    border-title-align: center;
    border-subtitle-align: center;
    border-subtitle-background: $background;
}

.del-label {
    height: 1;
    margin-top: 1;
    color: $text;
}

#del-host-row {
    height: 1;
    margin-top: 1;
}

#del-name {
    width: 1fr;
    height: 1;
    color: $text;
    text-style: bold;
}

#del-status {
    width: auto;
    height: 1;
}

#del-status.online  { color: $success; }

#del-status.warning { color: $warning; }

#del-status.offline { color: $text-muted; }

#del-address {
    height: 1;
    color: $text-muted;
}

.del-item {
    height: 1;
    color: $text-muted;
}

#del-warning {
    color: $bad;
}

#delete-buttons {
    height: 1;
    margin-top: 1;
    align-horizontal: center;
}

#delete-buttons Button {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 2;
    margin: 0 1;
    background: $tint;
    color: $text;
    text-style: none;
}

#delete-buttons Button:hover {
    background: $tint-hover;
}

#delete-buttons Button:focus {
    background: $error;
    color: $on-accent;
    text-style: bold;
}

#delete-buttons Button#btn-delete:focus {
    background: $bad;
    color: $on-accent;
}

#dels-host {
    height: 1;
    margin-top: 1;
    color: $text;
    text-style: bold;
}

.dels-line {
    height: 1;
}

.dels-branch {
    width: auto;
    height: 1;
    color: $error-darken-1;
}

#dels-name {
    width: auto;
    height: 1;
    color: $text;
}

#dels-port {
    width: auto;
    height: 1;
    color: $text-muted;
}

.del-note {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}
