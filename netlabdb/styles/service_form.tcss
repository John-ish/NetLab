AddServiceScreen {
    align: center middle;
    background: $shade;
}

#add-service-panel {
    width: 66;
    max-width: 90%;
    height: auto;
    max-height: 100%;
    overflow-y: auto;
    padding: 0 2 1 2;
    border: round $error;
    background: $background;
    border-title-color: $error;
    border-title-style: bold;
    border-title-background: $background;
    border-title-align: center;
    border-subtitle-align: center;
    border-subtitle-background: $background;
}

#add-service-panel Select {
    width: 1fr;
    height: 1;
}

.tree-label {
    width: auto;
    height: 1;
    color: $text;
}

.tree-top {
    height: 1;
    color: $error-darken-1;
}

.tree-head {
    height: 1;
}

.tree-branch {
    width: 5;
    height: 1;
    color: $error-darken-1;
}

.tree-title {
    width: auto;
    height: 1;
    color: $error-darken-1;
}

.tree-group {
    height: auto;
}

.tree-gutter {
    width: 5;
    height: auto;
    color: $error-darken-1;
}

.tree-body {
    width: 1fr;
    height: auto;
}

.tree-label-row {
    height: 1;
}

.tree-error {
    width: 1fr;
    height: 1;
    margin-left: 2;
    color: $bad;
}

.tree-body Input {
    width: 1fr;
    height: 1;
    padding: 0 1;
    border: none;
    background: $tint;
}

.tree-body Input:focus {
    border: none;
    background: $tint-hover;
    background-tint: transparent;
}

.tree-body Input.-invalid {
    background: $bad-tint;
}

.tree-body Input.-invalid:focus {
    background: $bad-tint-strong;
}

.tree-body Input > .input--placeholder {
    color: $placeholder;
}

#service-buttons {
    height: 1;
    margin-top: 1;
    align-horizontal: center;
}

#service-buttons Button {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 2;
    margin: 0 1;
    background: $tint;
    color: $text;
    text-style: none;
}

#service-buttons Button:hover {
    background: $tint-hover;
}

#service-buttons Button:focus {
    background: $error;
    color: $on-accent;
    text-style: bold;
}

#service-buttons Button:disabled {
    background: $tint-faint;
    color: $text-muted;
    text-style: none;
}
