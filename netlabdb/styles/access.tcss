AccessScreen {
    align: center middle;
    background: $shade;
}

#access-panel {
    width: 60;
    max-width: 90%;
    height: auto;
    max-height: 100%;
    overflow-y: auto;
    padding: 0 2 1 2;
    border: round $error;
    background: $background;
    border-title-color: $error;
    border-title-style: bold;
    border-title-background: $background;
    border-title-align: center;
    border-subtitle-align: center;
    border-subtitle-background: $background;
}

#access-body {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

#access-panel Select {
    width: 1fr;
    height: 1;
}

#access-buttons {
    height: 1;
    margin-top: 1;
    align-horizontal: center;
}

#access-buttons Button {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 2;
    margin: 0 1;
    background: $tint;
    color: $text;
    text-style: none;
}

#access-buttons Button:hover {
    background: $tint-hover;
}

#access-buttons Button:focus {
    background: $error;
    color: $on-accent;
    text-style: bold;
}

#access-buttons Button:disabled {
    background: $tint-faint;
    color: $text-muted;
    text-style: none;
}
