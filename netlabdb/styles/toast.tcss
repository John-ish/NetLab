Toast {
    width: auto;
    min-width: 28;
    max-width: 56;
    height: auto;
    padding: 0 1;
    background: $background;
    color: $text;
    border: round $error-darken-1;
}

Toast.-information {
    border: round $success;
}

Toast.-warning {
    border: round $warning;
}

Toast.-error {
    border: round $bad;
}

Toast .toast--title {
    text-style: bold;
}

Toast.-information .toast--title {
    color: $success;
}

Toast.-warning .toast--title {
    color: $warning;
}

Toast.-error .toast--title {
    color: $bad;
}
