#sv-panel {
    width: 100%;
    height: 100%;
    padding: 0 1 1 1;
    border: round $error-darken-1;
    border-title-color: $error;
    border-title-style: bold;
    border-title-align: center;
    border-subtitle-align: center;
    background: $background;
    overflow: hidden;
}

#sv-scroll {
    width: 100%;
    height: 1fr;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
    scrollbar-color: $error-darken-1;
    scrollbar-color-hover: $error;
    scrollbar-color-active: $error;
}

#sv-top { height: 10; }

#sv-bottom { height: 9; }

#sv-status, #sv-info, #sv-graph, #sv-res, #sv-checks, #sv-docker {
    border: round $error-darken-1;
    padding: 0 1;
    margin-right: 1;
    background: $background;
    border-title-color: $error;
    border-title-style: bold;
    border-subtitle-color: $error-darken-1;
    border-subtitle-align: right;
    overflow: hidden;
}

#sv-status { width: 1fr; height: 100%; }

#sv-info { width: 1fr; height: 100%; margin-right: 0; }

#sv-graph { width: 100%; height: 1fr; min-height: 11; margin-right: 0; }

#sv-res { width: 2fr; height: 100%; }

#sv-checks { width: 2fr; height: 100%; }

#card-access { width: 2fr; height: 100%; margin-right: 0; }

#sv-docker { width: 100%; height: auto; min-height: 3; margin-right: 0; }

#sv-docker Static { width: 1fr; height: auto; }

#sv-status Static, #sv-info Static, #sv-res Static, #sv-checks Static {
    width: 1fr;
}

#sv-range {
    height: 1;
    margin-bottom: 1;
}

#sv-graph-name {
    width: 1fr;
    height: 1;
    margin-left: 2;
}

#sv-chart {
    width: 1fr;
    height: 1fr;
}
