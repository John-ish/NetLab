SudoScreen {
    align: center middle;
    background: $shade;
}

#sudo-panel {
    width: 56;
    max-width: 90%;
    height: auto;
    padding: 0 2 1 2;
    border: round $error;
    background: $background;
    border-title-color: $error;
    border-title-style: bold;
    border-title-background: $background;
    border-title-align: center;
    border-subtitle-align: center;
    border-subtitle-background: $background;
}

#sudo-body {
    height: auto;
    margin-top: 1;
}

#sudo-input {
    height: 1;
    margin-top: 1;
    padding: 0 1;
    border: none;
    background: $tint;
}

#sudo-input:focus {
    border: none;
    background: $tint-hover;
    background-tint: transparent;
}

#sudo-status {
    height: 1;
    margin-top: 1;
    color: $bad;
}

#sudo-status.-busy {
    color: $warning;
}

#sudo-buttons {
    height: 1;
    margin-top: 1;
    align-horizontal: center;
}

#sudo-buttons Button {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 2;
    margin: 0 1;
    background: $tint;
    color: $text;
    text-style: none;
}

#sudo-buttons Button:hover {
    background: $tint-hover;
}

#sudo-buttons Button:focus {
    background: $error;
    color: $on-accent;
    text-style: bold;
}
