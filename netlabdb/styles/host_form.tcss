AddHostScreen, ConfirmScreen {
    align: center middle;
    background: $shade;
}

#add-host-panel, #confirm-panel {
    width: 76;
    max-width: 90%;
    height: auto;
    max-height: 100%;
    overflow-y: auto;
    padding: 0 2 1 2;
    border: round $error;
    background: $background;
    border-title-color: $error;
    border-title-style: bold;
    border-title-background: $background;
    border-title-align: center;
    border-subtitle-align: center;
    border-subtitle-background: $background;
}

#confirm-panel {
    width: 46;
}

.field-label {
    height: 1;
    margin-top: 1;
    color: $text;
}

.field-row {
    height: 1;
}

.field-row Input {
    width: 1fr;
    height: 1;
    padding: 0 1;
    border: none;
    background: $tint;
}

.field-row Input:focus {
    border: none;
    background: $tint-hover;
    background-tint: transparent;
}

.field-row Input.-invalid {
    background: $bad-tint;
}

.field-row Input.-invalid:focus {
    background: $bad-tint-strong;
}

.field-row Input > .input--placeholder {
    color: $placeholder;
}

.field-mark {
    width: 3;
    height: 1;
    padding-left: 1;
}

.field-mark.-ok {
    color: $success;
}

.field-mark.-bad {
    color: $bad;
}

.field-error {
    height: 1;
    color: $bad;
}

#test-result {
    height: 1;
    margin-top: 1;
    color: $text-muted;
}

#test-result.-ok {
    color: $success;
}

#test-result.-bad {
    color: $bad;
}

#test-result.-busy {
    color: $warning;
}

#confirm-body {
    width: 100%;
    height: auto;
    margin-top: 1;
    text-align: center;
}

#add-buttons, #confirm-buttons {
    height: 1;
    margin-top: 1;
    align-horizontal: center;
}

#add-buttons Button, #confirm-buttons Button {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 2;
    margin: 0 1;
    background: $tint;
    color: $text;
    text-style: none;
}

#add-buttons Button:hover, #confirm-buttons Button:hover {
    background: $tint-hover;
}

#add-buttons Button:focus, #confirm-buttons Button:focus {
    background: $error;
    color: $on-accent;
    text-style: bold;
}

#add-buttons Button:disabled {
    background: $tint-faint;
    color: $text-muted;
    text-style: none;
}
